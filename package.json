{
    "name": "photos-cms",
    "version": "0.0.0",
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@modelcontextprotocol/client": "^2.3.1",
        "@tsconfig/strictest": "^2.0.8",
        "@types/bun": "^1.4.2",
        "drizzle-kit": "^0.31.11",
        "prettier": "3.9.10",
        "typescript": "^7.0.2"
    },
    "private": true,
    "scripts": {
        "dev": "bun --watch src/main.ts",
        "start": "bun src/main.ts",
