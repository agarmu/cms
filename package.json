{
    "name": "photos-cms",
    "version": "0.0.0",
    "license": "GPL-3.0-or-later",
    "workspaces": [
        "apps/api",
        "apps/web"
    ],
    "devDependencies": {
        "@tsconfig/strictest": "^2.0.8",
        "@types/bun": "^1.4.2",
        "drizzle-kit": "^0.31.11",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "^0.14.1",
        "typescript": "^7.0.2"
    },
    "private": true,
    "scripts": {
        "dev": "bun run --filter @photos-cms/api dev",
        "start": "bun run --filter @photos-cms/api start",
        "dev:web": "bun run --filter @photos-cms/web dev",
        "build:web": "bun run --filter @photos-cms/web build",
        "preview:web": "bun run --filter @photos-cms/web preview",
        "scopes:dump": "bun scripts/dump-scopes.ts",
        "check": "tsc -p tsconfig.tools.json && bun run --filter '*' check",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "bun run --filter @photos-cms/api test",
        "test:integration": "bun run --filter @photos-cms/api test:integration",
        "db:generate": "bunx --bun drizzle-kit generate"
    },
    "type": "module"
}
