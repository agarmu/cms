---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
---

<SiteLayout
    title="Photos CMS"
    description="Photos CMS — a home for your photographs and their stories."
>
    <main>
        <div class="page-header">
            <p class="eyebrow">Photos CMS</p>
            <ThemeToggle />
        </div>
    </main>
</SiteLayout>

<style>
    @reference "../styles/theme.css";

    main {
        @apply mx-auto w-full max-w-2xl px-6 py-6;
    }

    .page-header {
        @apply flex items-center justify-between gap-4;
    }

    .eyebrow {
        @apply text-sm font-bold uppercase tracking-[0.12em];
    }
</style>
