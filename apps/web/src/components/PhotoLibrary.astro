---
import PhotoLightbox from "./PhotoLightbox.astro";
import VisibilityIcon from "./VisibilityIcon.astro";
import { Icon } from "astro-icon/components";
---

<section data-photo-library class="photo-library" aria-label="Photo library">
    <div
        data-library-status
        class="library-status"
        role="status"
        aria-live="polite"
    >
        <h2 data-status-title tabindex="-1">
            Opening your library...
        </h2>
        <p data-status-description>Checking your session.</p>
        <button data-retry type="button" hidden>
            Try again
        </button>
        <a data-status-back href="/" class="back-link" hidden>
            All photos
        </a>
    </div>

    <div data-library-view hidden>
        <ul
            data-photo-grid
            class="photo-grid"
            aria-label="Photos"
            tabindex="-1"
        />
        <nav class="pagination" aria-label="Photo pages">
            <a data-previous href="/">
                Previous
            </a>
            <a data-next href="/">
                Next
            </a>
        </nav>
    </div>

    <article data-photo-view hidden aria-label="Photo details" tabindex="-1">
        <div class="entry-toolbar">
            <a
                data-back
                href="/"
                class="back-link"
                aria-label="All photos"
                title="All photos"
            >
                <Icon name="lucide:arrow-left" aria-hidden="true" />
            </a>
        </div>
        <div class="entry-layout">
            <figure class="photo-preview">
                <div data-photo-image class="detail-image" />
                <figcaption class="variant-sizes">
                    <ul data-photo-variants aria-label="Image variant sizes" />
                </figcaption>
            </figure>
            <div class="detail-copy">
                <div class="detail-toolbar">
                    <span class="visibility-item">
                        <VisibilityIcon />
                    </span>
                    <dl class="entry-summary" aria-label="Photo summary">
                        <div class="summary-item" data-equipment="camera">
                            <dt class="sr-only">Camera</dt>
                            <dd>
                                <span
                                    data-camera-present
                                    class="equipment-icon"
                                >
                                    <Icon
                                        name="lucide:camera"
                                        aria-hidden="true"
                                    />
                                </span>
                                <span
                                    data-camera-missing
                                    class="equipment-icon"
                                    hidden
                                >
                                    <Icon
                                        name="lucide:camera-off"
                                        aria-hidden="true"
                                    />
                                </span>
                                <span data-photo-camera data-photo-field />
                            </dd>
                        </div>
                        <div class="summary-item" data-equipment="lens">
                            <dt class="sr-only">Lens</dt>
                            <dd>
                                <span data-lens-present class="equipment-icon">
                                    <Icon
                                        name="lucide:aperture"
                                        aria-hidden="true"
                                    />
                                </span>
                                <span
                                    data-lens-missing
                                    class="equipment-icon lens-missing-icon"
                                    hidden
                                >
                                    <Icon
                                        name="lucide:aperture"
                                        aria-hidden="true"
                                    />
                                    <svg
                                        class="lens-strike"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        aria-hidden="true"
                                    >
                                        <path
                                            d="m3 3 18 18"
                                            stroke="var(--background)"
                                            stroke-width="5"
                                            stroke-linecap="round"
                                        />
                                        <path
                                            d="m3 3 18 18"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                        />
                                    </svg>
                                </span>
                                <span data-photo-lens data-photo-field />
                            </dd>
                        </div>
                        <div class="summary-item date-item">
                            <dt>
                                <Icon name="lucide:clock" aria-hidden="true" />
                                Taken
                            </dt>
                            <dd>
                                <time data-photo-taken data-photo-field />
                            </dd>
                        </div>
                        <div class="summary-item date-item">
                            <dt>
                                <Icon name="lucide:clock" aria-hidden="true" />
                                Posted
                            </dt>
                            <dd>
                                <time data-photo-posted data-photo-field />
                            </dd>
                        </div>
                    </dl>
                </div>
                <dl>
                    <div class="metadata-wide">
                        <dt>Description</dt>
                        <dd data-photo-description data-photo-field />
                    </div>
                    <div class="metadata-wide">
                        <dt>Alt text</dt>
                        <dd data-photo-alt data-photo-field />
                    </div>
                </dl>
            </div>
        </div>
    </article>

    <PhotoLightbox />

    <template data-photo-card>
        <li class="photo-card">
            <a class="photo-link">
                <div class="thumbnail" data-thumbnail />
                <div class="card-copy">
                    <p>
                        <time /> <VisibilityIcon />
                    </p>
                </div>
            </a>
        </li>
    </template>

    <noscript>
        <p>Enable JavaScript to sign in and browse your photos.</p>
    </noscript>
</section>

<script>
    import { mountLibrary } from "@/lib/library";

    const root = document.querySelector<HTMLElement>("[data-photo-library]");
    if (root) mountLibrary(root);
</script>

<style>
    @reference "../styles/theme.css";

    .photo-library {
        @apply flex-1 py-8;
    }
    h2 {
        @apply break-words font-bold fl-text-xl/3xl--sm-lg;
    }
    h2:focus {
        outline: none;
    }
    [data-photo-grid]:focus,
    [data-photo-view]:focus {
        outline: none;
    }
    .library-status {
        @apply flex min-h-72 flex-col items-center justify-center gap-3 text-center;
    }
    .library-status p {
        @apply max-w-md text-muted-foreground;
    }
    .library-status button {
        @apply mt-2;
    }
    .photo-grid {
        @apply grid grid-cols-1 gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3;
    }
    .pagination {
        @apply mt-8 flex items-center justify-between gap-4 border-t border-neutral-200 pt-5 dark:border-neutral-800;
    }
    .pagination a,
    button {
        @apply inline-flex min-h-11 cursor-pointer items-center justify-center rounded-md border border-neutral-200 px-4 py-2 text-sm font-bold transition-colors dark:border-neutral-800;
    }
    .pagination a:hover,
    button:hover {
        @apply bg-neutral-100 dark:bg-neutral-800;
    }
    .pagination [data-next] {
        @apply ml-auto;
    }
    a:focus-visible,
    button:focus-visible {
        @apply outline-2 outline-offset-4 outline-primary;
    }
    .back-link {
        @apply inline-flex min-h-11 items-center text-sm font-bold text-muted-foreground;
    }
    .entry-toolbar {
        @apply mb-6 flex flex-wrap items-center justify-between gap-3;
    }
    .entry-toolbar .back-link {
        @apply size-11 justify-center rounded-md hover:bg-neutral-100 dark:hover:bg-neutral-800;
    }
    .entry-toolbar :global(svg) {
        @apply size-5;
    }
    .detail-toolbar {
        @apply flex items-start gap-3;
    }
    .visibility-item {
        @apply inline-flex size-10 shrink-0 items-center justify-center rounded-md border border-neutral-200 dark:border-neutral-800;
    }
    .detail-toolbar .visibility-item :global(svg) {
        @apply size-4;
    }
    .entry-summary {
        @apply m-0 flex min-w-0 flex-1 flex-wrap items-center gap-2;
    }
    .summary-item {
        @apply flex min-h-10 min-w-0 max-w-full items-center rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800;
    }
    .entry-summary dd {
        @apply m-0 flex min-w-0 max-w-full items-center gap-2 whitespace-normal text-sm;
    }
    .entry-summary [data-photo-camera],
    .entry-summary [data-photo-lens] {
        @apply min-w-0 break-words;
    }
    .date-item {
        @apply inline-flex flex-wrap items-center gap-2;
    }
    .date-item dt {
        @apply inline-flex items-center gap-2;
    }
    .entry-summary :global(svg) {
        @apply block size-4 shrink-0 text-muted-foreground;
    }
    .equipment-icon {
        @apply inline-flex size-4 shrink-0 items-center justify-center;
    }
    .lens-missing-icon {
        @apply relative;
    }
    .lens-strike {
        @apply absolute inset-0;
    }
    .entry-layout {
        @apply grid items-start gap-8 md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)];
    }
    .detail-image {
        @apply w-full max-w-80;
    }
    .photo-preview {
        @apply min-w-0 max-w-80;
    }
    .variant-sizes {
        @apply mt-3 text-sm text-muted-foreground;
    }
    .variant-sizes ul {
        @apply flex flex-col gap-2 tabular-nums;
    }
    .variant-sizes :global(li) {
        @apply flex items-baseline gap-3;
    }
    .variant-sizes :global(.variant-name) {
        @apply inline-block min-w-24 shrink-0 font-medium;
    }
    .detail-copy {
        @apply min-w-0;
    }
    dl {
        @apply mt-5 grid gap-5 sm:grid-cols-2;
    }
    .metadata-wide {
        @apply sm:col-span-2;
    }
    dt {
        @apply text-sm text-muted-foreground;
    }
    dd {
        @apply mt-1 whitespace-pre-wrap break-words;
    }

    /* Cards and images are created from API data in the browser. */
    .photo-grid :global(.photo-link) {
        @apply block rounded-lg;
    }
    .photo-grid :global(.photo-link:focus-visible) {
        @apply outline-2 outline-offset-4 outline-primary;
    }
    .photo-grid :global(.thumbnail) {
        @apply aspect-[4/3] overflow-hidden rounded-lg bg-neutral-100 dark:bg-neutral-900;
    }
    .photo-grid :global(.card-copy) {
        @apply mt-3;
    }
    .photo-grid :global(.card-copy p) {
        @apply mt-1 flex items-center justify-between gap-2 text-sm text-muted-foreground;
    }
    .photo-library :global(.image-frame) {
        @apply relative flex min-h-32 items-center justify-center;
    }
    .photo-library :global(.image-status) {
        @apply p-5 text-center text-sm text-muted-foreground;
    }
    .photo-library :global(.image-retry) {
        @apply absolute inset-0 flex cursor-pointer items-center justify-center bg-background/90 p-4 text-sm font-bold;
    }
    .photo-library :global(.image-retry:focus-visible) {
        @apply outline-2 -outline-offset-4 outline-primary;
    }
    .photo-grid :global(img) {
        @apply block size-full object-cover transition-opacity;
    }
    .photo-grid :global(.photo-link:hover img) {
        @apply opacity-90;
    }
    .detail-image:global(.image-frame) {
        @apply min-h-0 items-start justify-start;
    }
    .detail-image :global(img) {
        @apply block h-auto max-h-80 w-auto max-w-full object-contain;
    }
    .detail-image :global(.photo-open) {
        @apply block w-fit max-w-full cursor-zoom-in appearance-none border-0 bg-transparent p-0;
    }
    .detail-image :global(.photo-open:focus-visible) {
        @apply outline-2 outline-offset-4 outline-primary;
    }
    .detail-image :global(.image-status) {
        @apply content-center;
    }
    [hidden],
    .photo-library :global([hidden]) {
        display: none !important;
    }
</style>
