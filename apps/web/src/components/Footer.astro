---
import { Icon } from "astro-icon/components";
import IconButton from "./IconButton.astro";
---

<footer>
    <span class="repository-link">
        <IconButton
            href="https://github.com/agarmu/cms"
            label="View agarmu/cms on GitHub"
        >
            <Icon name="lucide:github" aria-hidden="true" />
        </IconButton>
    </span>
</footer>

<style>
    @reference "../styles/theme.css";

    footer {
        @apply mx-auto mt-auto flex w-full max-w-6xl px-6 py-4;
    }

    .repository-link {
        @apply -ml-3 inline-flex text-muted-foreground;
    }

    @media (min-width: 40rem) {
        /* The photo column reserves this space, so the text needs no extra row. */
        :global(body:has([data-photo-view]:not([hidden]))) footer {
            @apply relative -mt-19 pointer-events-none;
        }

        .repository-link {
            @apply pointer-events-auto;
        }
    }
</style>
