---
import { Icon } from "astro-icon/components";
import IconButton from "./IconButton.astro";
---

<footer>
    <span class="repository-link">
        <IconButton
            href="https://github.com/agarmu/cms"
            label="View agarmu/cms on GitHub"
        >
            <Icon name="lucide:github" aria-hidden="true" />
        </IconButton>
    </span>
</footer>

<style>
    @reference "../styles/theme.css";

    footer {
        @apply mx-auto mt-auto flex w-full max-w-6xl justify-center px-6 py-4;
    }

    .repository-link {
        @apply inline-flex text-muted-foreground;
    }

    @media (min-width: 40rem) {
        :global(body:has([data-photo-view]:not([hidden]))) footer {
            @apply grid grid-cols-[minmax(16rem,2fr)_minmax(0,3fr)] gap-6;
        }

        .repository-link {
            @apply justify-self-center;
        }
    }

    @media (min-width: 40rem) and (min-height: 30rem) {
        /* The photo column reserves room for this pinned footer. */
        :global(body:has([data-photo-view]:not([hidden]))) footer {
            @apply pointer-events-none fixed inset-x-0 bottom-0;
        }

        .repository-link {
            @apply pointer-events-auto;
        }
    }
</style>
