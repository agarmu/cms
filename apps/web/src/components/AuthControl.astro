---
import { config } from "@/lib/config";
import { Icon } from "astro-icon/components";
import { Menu } from "@starwind-ui/astro/menu";
import IconButton from "./IconButton.astro";

interface Props {
    action: "sign-in" | "sign-out";
}
const { action } = Astro.props;
---

{config.auth.kind === "oidc" && (
    <div
        class:list={["auth-control", `auth-control--${action}`]}
        data-auth-control={action}
        hidden={action === "sign-out"}
    >
        <div class="auth-content">
            {action === "sign-in" ? (
                <button type="button" data-auth-action disabled>
                    Sign in
                </button>
            ) : (
                <Menu.Root>
                    <IconButton
                        label="Account"
                        title="Account"
                        data-sw-menu-trigger
                        aria-haspopup="menu"
                        aria-expanded="false"
                        disabled
                    >
                        <Icon name="lucide:user" aria-hidden="true" />
                    </IconButton>
                    <Menu.Popup
                        class="account-menu"
                        align="end"
                        sideOffset={8}
                        aria-label="Account"
                    >
                        <button
                            type="button"
                            data-auth-action
                            data-sw-menu-item
                            role="menuitem"
                            disabled
                        >
                            Sign out
                        </button>
                    </Menu.Popup>
                </Menu.Root>
            )}
            <p class="auth-error" role="alert" hidden />
        </div>
    </div>
)}

<script>
    import {
        auth,
        getSession,
        initializeSession,
        signIn,
        signOut,
        subscribeSession,
    } from "@/lib/auth";

    const params = new URL(window.location.href).searchParams;
    const returningFromSignIn =
        params.has("state") && (params.has("code") || params.has("error"));

    for (const control of document.querySelectorAll<HTMLElement>(
        "[data-auth-control]",
    )) {
        const button =
            control.querySelector<HTMLButtonElement>("[data-auth-action]");
        const trigger = control.querySelector<HTMLButtonElement>(
            "[data-sw-menu-trigger]",
        );
        const message =
            control.querySelector<HTMLParagraphElement>("[role=alert]");
        if (!auth || !button || !message) continue;
        const signingIn = control.dataset["authControl"] === "sign-in";
        let busy = false;
        const setDisabled = (disabled: boolean) => {
            button.disabled = disabled;
            if (trigger) trigger.disabled = disabled;
        };
        const render = async () => {
            await initializeSession();
            const session = await getSession();
            if (
                !session.ready &&
                trigger?.getAttribute("aria-expanded") === "true"
            ) {
                trigger.click();
            }
            control.hidden = signingIn ? session.ready : !session.ready;
            message.textContent = session.error ?? "";
            message.hidden = !session.error;
        };

        subscribeSession(() => void render());
        button.addEventListener("click", async () => {
            busy = true;
            setDisabled(true);
            message.hidden = true;
            try {
                if (signingIn) await signIn();
                else await signOut();
            } catch (error) {
                message.textContent =
                    error instanceof Error ? error.message : "Sign-in failed.";
                message.hidden = false;
            } finally {
                busy = false;
                setDisabled(false);
            }
        });

        // Silent session recovery can finish in the background.
        setDisabled(returningFromSignIn);
        void render().finally(() => {
            if (!busy) setDisabled(false);
        });
    }
</script>

<style>
    @reference "../styles/theme.css";

    .auth-control {
        @apply relative shrink-0 text-sm;
    }

    .auth-control--sign-in {
        @apply flex flex-1 items-center justify-center py-8;
    }

    .auth-content {
        @apply flex max-w-full flex-col items-center gap-4;
    }

    button {
        @apply inline-flex cursor-pointer items-center justify-center rounded-md font-bold whitespace-nowrap transition-colors;
        @apply focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary;
        @apply disabled:cursor-wait disabled:opacity-50;
    }

    .auth-control--sign-in button {
        @apply min-h-16 min-w-52 max-w-full border border-blue-700 bg-blue-700 px-10 py-4 text-xl text-white enabled:hover:border-blue-800 enabled:hover:bg-blue-800;
    }

    .account-menu {
        @apply z-50 min-w-36 rounded-md border border-neutral-200 bg-background p-1 text-foreground shadow-lg dark:border-neutral-800;
    }

    .account-menu button {
        @apply min-h-10 w-full justify-start px-3 py-2 text-sm font-normal hover:bg-neutral-100 focus-visible:bg-neutral-100 dark:hover:bg-neutral-800 dark:focus-visible:bg-neutral-800;
    }

    .auth-error {
        @apply max-w-sm text-center text-red-600;
    }

    .auth-control--sign-out .auth-error {
        @apply absolute top-full right-0 z-10 mt-2 w-56 rounded-md border border-red-600 bg-background p-3 text-red-600;
    }

    [hidden] {
        display: none !important;
    }
</style>
