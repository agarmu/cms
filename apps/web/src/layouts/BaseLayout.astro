---
import { Font } from "astro:assets";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import { Icon } from "astro-icon/components";
import Footer from "@/components/Footer.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import AuthControl from "@/components/AuthControl.astro";
import DemoNotice from "@/components/DemoNotice.astro";
import { isDemoPath } from "@/lib/demo-mode";
import "@/styles/theme.css";

interface Props {
    title?: string;
    description?: string;
    chrome?: boolean;
}
const { title = "Photos CMS", description, chrome = true } = Astro.props;
const home = isDemoPath(Astro.url.pathname) ? "/demo/" : "/";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {description && <meta name="description" content={description} />}
        <title>{title}</title>
        {chrome && <Font cssVariable="--font-atkinson-hyperlegible" preload />}
        {chrome && <ThemeInitScript />}
    </head>
    <body>
        <main>
            {chrome && (
                <header>
                    <h1 data-library-heading>
                        <a href={home}>Photos CMS</a>
                    </h1>
                    <a
                        data-back
                        href={home}
                        class="back-link"
                        aria-label="All photos"
                        title="All photos"
                        hidden
                    >
                        <Icon name="lucide:arrow-left" aria-hidden="true" />
                    </a>
                    <div class="header-actions">
                        <a
                            data-add-photo
                            href={`${home}?new=1`}
                            class="add-photo"
                            aria-label="Add photo"
                            title="Add photo"
                            hidden
                        >
                            <Icon name="lucide:plus" aria-hidden="true" />
                        </a>
                        <AuthControl action="sign-out" />
                        <ThemeToggle />
                    </div>
                </header>
            )}
            {chrome && <DemoNotice />}
            <slot />
        </main>
        {chrome && <Footer />}
    </body>
</html>

<style>
    @reference "../styles/theme.css";

    body {
        @apply flex min-h-dvh flex-col bg-background text-foreground antialiased scheme-light dark:scheme-dark;
    }
    body:has(dialog[open]) {
        overflow: hidden;
    }

    main {
        @apply mx-auto flex w-full max-w-6xl flex-1 flex-col px-6 pt-6;
    }

    header {
        @apply flex shrink-0 items-center justify-between gap-4;
    }

    @media (min-width: 40rem) and (min-height: 30rem) {
        body:has([data-photo-view]:not([hidden])) {
            @apply h-dvh overflow-hidden;
        }

        body:has([data-photo-view]:not([hidden])) main {
            @apply min-h-0;
        }
    }

    h1 {
        @apply font-bold fl-text-base/2xl--sm-lg;
    }

    .header-actions {
        @apply ml-auto flex shrink-0 items-center gap-2;
    }

    .back-link,
    .add-photo {
        @apply inline-flex size-11 items-center justify-center rounded-md text-muted-foreground hover:bg-neutral-100 dark:hover:bg-neutral-800;
    }

    .back-link:focus-visible,
    .add-photo:focus-visible {
        @apply outline-2 outline-offset-4 outline-primary;
    }

    .back-link :global(svg) {
        @apply size-5;
    }

    .add-photo :global(svg) {
        @apply fl-size-5/6--sm-lg;
    }

    [hidden] {
        display: none !important;
    }
</style>
