---
import { Font } from "astro:assets";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import Footer from "@/components/Footer.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import "@/styles/theme.css";

interface Props {
    title?: string;
    description?: string;
    chrome?: boolean;
}
const { title = "Photos CMS", description, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {description && <meta name="description" content={description} />}
        <title>{title}</title>
        {chrome && <Font cssVariable="--font-atkinson-hyperlegible" preload />}
        {chrome && <ThemeInitScript />}
    </head>
    <body>
        <main>
            {chrome && (
                <header>
                    <h1>
                        <a href="/">Photos CMS</a>
                    </h1>
                    <ThemeToggle />
                </header>
            )}
            <slot />
        </main>
        {chrome && <Footer />}
    </body>
</html>

<style>
    @reference "../styles/theme.css";

    body {
        @apply flex min-h-screen flex-col bg-background text-foreground antialiased scheme-light dark:scheme-dark;
    }

    main {
        @apply mx-auto flex w-full max-w-6xl flex-1 flex-col px-6 py-6;
    }

    header {
        @apply flex items-center justify-between gap-4;
    }

    h1 {
        @apply font-bold fl-text-base/2xl--sm-lg;
    }
</style>
